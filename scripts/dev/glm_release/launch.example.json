    "known_hosts": "/REQUIRED_OPERATOR_KNOWN_HOSTS",
    "environment": []
  },
  "nodes": [
    {
      "rank": 0,
      "destination": "REQUIRED_RANK0_SSH_DESTINATION",
      "supervisor_path": "/REQUIRED_PINNED_HELPER_DIRECTORY/glm-pair-supervisor",
      "supervisor_sha256": "REQUIRED_SUPERVISOR_ELF_SHA256",
      "relay_path": "/REQUIRED_PINNED_HELPER_DIRECTORY/glm-pair-relay",
      "relay_sha256": "REQUIRED_RELAY_ELF_SHA256",
      "guard_container_path": "/usr/local/bin/glm-pair-guard",
      "recipe_file": "/REQUIRED_GENERATED_RECIPE",
      "recipe_sha256": "REQUIRED_GENERATED_RECIPE_SHA256"
    },
    {
      "rank": 1,
      "destination": "REQUIRED_RANK1_SSH_DESTINATION",
      "supervisor_path": "/REQUIRED_PINNED_HELPER_DIRECTORY/glm-pair-supervisor",
      "supervisor_sha256": "REQUIRED_SUPERVISOR_ELF_SHA256",
      "relay_path": "/REQUIRED_PINNED_HELPER_DIRECTORY/glm-pair-relay",
      "relay_sha256": "REQUIRED_RELAY_ELF_SHA256",
