{
  "version": 1,
  "policy": {
    "startup": 90000,
    "lease": 120000,
    "challenge": 10000,
    "frame": 5000,
    "campaign": 1800000,
    "poll": 10,
    "reap": 5000,
    "child_handshake": 30000,
    "quiescent_wait": 30000,
    "exit": 10000
  },
  "controller": {
