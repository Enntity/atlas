    "program_sha256": "REQUIRED_PYTHON_ELF_SHA256",
    "argv": [
      "-I",
      "-",
      "http://REQUIRED_HEAD_HTTP_HOST:8890",
      "/var/tmp/models/glm53-flash-nvfp4"
    ],
    "environment": [],
    "input_file": "/REQUIRED_WORKLOAD_FROM_MATERIALIZER",
    "input_sha256": "REQUIRED_GENERATED_WORKLOAD_SHA256",
    "limits": {
      "timeout_ms": 1190000,
      "stdout_bytes": 1048576,
      "stderr_bytes": 65536,
      "stdin_bytes": 65536,
